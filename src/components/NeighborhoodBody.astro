---
import { u } from '../lib/utils';
const { n, all, city, services, phoneHref, phoneDisplay } = Astro.props;
---
<div class="nh-body">
{n.body.map((s, i) => <section class:list={['nh-section', {'nh-alt': i % 2 === 1}]}><div class="nh-inner">
<h2>{s.h}</h2>
{s.ps?.map(p => <p>{p}</p>)}
{s.bullets && <><h3>What Local Property Owners Often Consider</h3><ul>{s.bullets.map(b => <li>{b}</li>)}</ul></>}
{s.subs?.map(t => <><h3>{t.h}</h3>{t.ps.map(p => <p>{p}</p>)}{t.bullets && <ul>{t.bullets.map(b => <li>{b}</li>)}</ul>}</>)}
{i === 0 && <div class="nh-services"><h2>Hydro Jetting Services in {n.name}</h2><p>Match the observed drain problem to the service, then confirm the method against the actual line.</p><div class="nh-grid">{services.map((s, k) => <a class="nh-card" href={u(s.path)}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={['M12 3C9 7 5 11 5 15a7 7 0 0 0 14 0c0-4-4-8-7-12Z','M5 20C5 10 10 4 20 4c0 10-5 15-14 15M5 20l9-10','M4 8h15l-4-4M20 16H5l4 4','M3 8l9-5 9 5-9 5-9-5Zm0 7 9 5 9-5','M12 3l8 3v6c0 5-4 8-8 10-4-2-8-5-8-10V6l8-3Z'][k % 5]} /></svg><h3>{s.name}</h3><p>{s.note} in {n.name}. The inspection determines whether cleaning fits the pipe.</p><span>Learn more &rarr;</span></a>)}</div></div>}
</div></section>)}
<section class="nh-section nh-alt"><div class="nh-inner"><h2>Planning Hydro Jetting in {n.name}</h2><p>Prepare the information about the property before choosing a cleaning method. This sequence keeps the request tied to the actual line rather than a neighborhood-wide assumption.</p><ol class="nh-steps">{n.steps.map(s => <li><h3>{s[0]}</h3><p>{s[1]}</p></li>)}</ol></div></section>
<section class="nh-section"><div class="nh-inner"><h2>Map: {n.name}, {city}</h2><p>{n.mapIntro}</p><div class="nh-map"><iframe src={n.mapSrc} width="100%" height="450" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`${n.name} area context map`} /></div></div></section>
<section class="nh-section nh-alt"><div class="nh-inner"><h2>Other {city} Neighborhood Pages</h2><p>These pages cover other local planning contexts. They are not confirmation of service availability at an individual address.</p><div class="nh-pills">{all.filter(a => a.slug !== n.slug).map(a => <a href={u(`/neighborhood/${a.slug}/`)}>{a.name}</a>)}</div></div></section>
<section class="nh-section"><div class="nh-inner"><h2>Hydro Jetting Questions for {n.name}</h2><div class="nh-faq">{n.faqs.map(f => <article><h3>{f.q}</h3><p>{f.a}</p></article>)}</div></div></section>
<section class="nh-section nh-alt"><div class="nh-inner"><h2>{n.cta}</h2><p>{n.ctaP}</p><div class="nh-pills"><a href="#request-service">Request service</a><a href={phoneHref}>Call {phoneDisplay}</a></div></div></section>
</div>
<style is:global>
.nh-body{--nh-line:color-mix(in srgb,currentColor 18%,transparent);--nh-tint:color-mix(in srgb,currentColor 4%,transparent)}.nh-section{padding:64px 24px}.nh-inner{max-width:1120px;margin:0 auto}.nh-alt{background:var(--nh-tint)}.nh-body h2{font-size:clamp(26px,3vw,36px);line-height:1.2;margin:0 0 24px;font-weight:700}.nh-body h3{font-size:22px;line-height:1.3;margin:28px 0 12px;font-weight:650}.nh-body p,.nh-body li{font-size:17px;line-height:1.75}.nh-body p{max-width:900px;margin:0 0 20px}.nh-body ul{padding-left:24px;list-style:disc;margin:20px 0 30px}.nh-body li{margin:10px 0}.nh-services{margin-top:46px}.nh-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.nh-card{border:1px solid var(--nh-line);border-radius:12px;padding:25px;display:block;color:inherit;text-decoration:none;transition:transform .15s}.nh-card:hover{transform:translateY(-3px)}.nh-card svg{width:36px;height:36px;fill:none;stroke:currentColor;stroke-width:1.7}.nh-card h3{margin:18px 0 12px}.nh-card p{font-size:16px}.nh-card span{font-weight:650}.nh-steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;list-style-position:inside;padding:0}.nh-steps li{border-top:1px solid var(--nh-line);padding:20px 0}.nh-steps h3{margin:8px 0 12px}.nh-map{border:1px solid var(--nh-line);border-radius:12px;overflow:hidden}.nh-map iframe{display:block;width:100%;max-width:100%}.nh-pills{display:flex;flex-wrap:wrap;gap:12px}.nh-pills a{border:1px solid var(--nh-line);border-radius:999px;padding:12px 20px;color:inherit;text-decoration:none;font-weight:600}.nh-faq{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.nh-faq article{border:1px solid var(--nh-line);border-radius:12px;padding:24px}.nh-faq h3{margin:0 0 14px}.nh-faq p{margin:0}@media(max-width:700px){.nh-section{padding:44px 20px}.nh-grid,.nh-steps,.nh-faq{grid-template-columns:1fr}.nh-body h2{font-size:28px}.nh-card,.nh-faq article{padding:22px}.nh-body p,.nh-body li{font-size:16px}.nh-map iframe{height:350px}}
</style>
