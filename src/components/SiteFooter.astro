---
import { business, serviceLinks, hoodLinks, guideLinks } from '../lib/site';
import { phoneIcon, drop } from './Icons';
import { u } from '../lib/utils';
const [b1, b2, b3] = [business.city, 'Hydro Jetting', 'Pros'];
---
<footer class="ftr">
  <div class="ftr-in">
    <div class="ftr-brand"><a class="brand" href={u('/')}><span class="brand-ico" set:html={drop} /><span class="brand-txt">{b1}{" "}<em>{b2}</em>{" "}{b3}</span></a>
      <p>{business.description}</p></div>
    <div><h4>Guides</h4>{guideLinks.map((l) => <a href={u(l.href)}>{l.label}</a>)}</div>
    <div><h4>Neighborhoods</h4>{hoodLinks.map((l) => <a href={u(l.href)}>{l.label}</a>)}</div>
    <div><h4>Services</h4>{serviceLinks.map((l) => <a href={u(l.href)}>{l.label}</a>)}<a href={u('/contact/')}>Request service</a><a href={u('/privacy/')}>Privacy</a><a href={u('/terms/')}>Terms</a></div>
  </div>
  <div class="ftr-copy">&copy; 2026 {business.name}. No service or result is guaranteed.</div>
</footer>
<a class="fab-deal" href={business.phoneHref} aria-label={`Call ${business.name} at ${business.phoneDisplay}`}><span class="fab-deal-ico" aria-hidden="true" set:html={phoneIcon} /><span class="fab-deal-text"><span class="fab-deal-text-k">Call now</span><span class="fab-deal-text-v">{business.phoneDisplay}</span></span></a>
<script is:inline>
(function(){function run(){if(!('IntersectionObserver' in window))return;var forms=document.querySelectorAll('form[data-lead-form]');if(!forms.length)return;var fx=[].filter.call(document.querySelectorAll('body *'),function(e){return getComputedStyle(e).position==='fixed'&&!e.closest('header')&&(e.matches('a[href^="tel:"]')||e.querySelector('a[href^="tel:"]'))&&e.getClientRects().length});if(!fx.length)return;fx.forEach(function(e){e.style.transition='opacity .2s ease'});var vis=new Set();var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){vis.add(x.target)}else{vis.delete(x.target)}});fx.forEach(function(e){e.style.opacity=vis.size?'0':'';e.style.pointerEvents=vis.size?'none':''})});forms.forEach(function(f){io.observe(f)})}if(document.readyState==='complete'){run()}else{window.addEventListener('load',run)}})();
</script>
