---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import ContactSection from './ContactSection.astro';
import { u } from '../lib/utils';
import { faqSchema } from '../lib/seo';
import { pageImage } from '../lib/pageImages';
const { path, title, description, h1, intro, lead = [], sections = [], faqs = [], related = [], parent, name, location, service = false, legal = false } = Astro.props;
const crumbs = [...(parent ? [{ name: parent.name, path: parent.path }] : []), { name, path }];
const heroCrumbs = crumbs.map((c) => ({ href: c.path, label: c.name }));
const img = pageImage(h1);
---
<Base title={title} description={description} path={path} crumbs={crumbs} service={service} extraSchema={faqs.length ? [faqSchema(faqs)] : []}>
  <Hero headline={h1} intro={intro} crumbs={heroCrumbs} />
  {lead.length > 0 && <section class="sec sec-lede"><div class="sec-in prose">{lead.map((p) => <p set:html={p} />)}</div></section>}
  {path.includes('/guides/') && <section class="sec sec-prose sec-a"><div class="sec-in"><table class="comparison"><caption>What each step can establish</caption><thead><tr><th>Step</th><th>Purpose</th><th>Limit</th></tr></thead><tbody><tr><td>Inspection</td><td>Locate visible obstruction and pipe defects</td><td>Does not itself clear the drain</td></tr><tr><td>Water jetting</td><td>Direct water at debris in a suitable line</td><td>Does not rebuild damaged pipe</td></tr><tr><td>Mechanical cleaning</td><td>Use a rotating tool to break an obstruction</td><td>Choice depends on the actual line</td></tr></tbody></table></div></section>}
  {sections.map((s, i) => (
    <section class={`sec sec-prose sec-${i % 2 ? 'a' : 'b'}`}><div class="sec-in">
      <h2>{s.h}</h2>
      {s.ps.map((p) => <p set:html={p} />)}
      {i === 0 && !legal && <figure class="sec-fig"><img src={u(img.src)} alt={img.alt} width="1200" height="896" loading="lazy" decoding="async" /><figcaption>Illustrative image, not a photo of a local job.</figcaption></figure>}
    </div></section>
  ))}
  {related.length > 0 && <section class="sec sec-prose sec-a"><div class="sec-in">{related.map((r) => <a href={u(r.href)}>{r.label} &rarr;</a>)}</div></section>}
  {faqs.length > 0 && (
    <section class="sec sec-faq"><div class="sec-in">
      <h2>Questions about this drain problem</h2>
      <div class="faq">{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div></section>
  )}
  {!legal && <ContactSection location={location ?? name} />}
  {legal && <ContactSection location={location ?? name} title="Questions about this page?" text="Call or send a note and we will follow up." />}
</Base>
