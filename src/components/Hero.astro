---
import RequestForm from './RequestForm.astro';
import { business } from '../lib/site';
import { skin } from '../data/skin';
import { u } from '../lib/utils';
const { headline, intro, crumbs = [], home = false, location = home ? 'Homepage' : headline } = Astro.props;
---
<section class={`hero ${home ? 'hero-home' : 'hero-page'}`}>
  {home && <img class="hero-bg" src={u(skin.heroImage)} alt={skin.heroAlt} width="1808" height="1008" fetchpriority="high" decoding="async" />}
  {home && <div class="hero-shade"></div>}
  <div class="hero-in"><div class="hero-copy">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb"><a href={u('/')}>Home</a>{crumbs.map((c, i) => <>{' / '}{i < crumbs.length - 1 ? <a href={u(c.href)}>{c.label}</a> : <span>{c.label}</span>}</>)}</nav>
    )}
    <h1>{headline}</h1>
    <p class="hero-p">{intro}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={business.phoneHref} aria-label={`Call ${business.name} at ${business.phoneDisplay}`}>{business.phoneDisplay}</a>
      <a class="btn btn-ghost" href="#request-service">Request a Call</a>
    </div>
  </div><RequestForm location={location} /></div>
  {skin.wave && home && <svg class="wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 80L60 70C120 60 240 40 360 35C480 30 600 40 720 45C840 50 960 50 1080 45C1200 40 1320 30 1380 25L1440 20V80H0Z" fill="#f8fafc" /></svg>}
</section>
