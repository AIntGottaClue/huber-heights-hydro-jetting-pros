---
import '../styles/site.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_URL, business } from '../lib/site';
import { pageSchema } from '../lib/seo';
import { siteConfig } from '../data/siteConfig';
import { skin } from '../data/skin';
import { u } from '../lib/utils';
const { title, description, path, crumbs = [], extraSchema = [], service = false } = Astro.props;
const canonical = `${SITE_URL}${path}`;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={skin.themeColor} />
    <meta name="robots" content={import.meta.env.BASE_URL === "/" ? "index, follow" : "noindex, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={skin.fontsHref} />
    <JsonLd data={pageSchema(path, title, description, crumbs, service)} />
    {extraSchema.map((s) => <JsonLd data={s} />)}
    {siteConfig.ga4MeasurementId && <><script is:inline async src={'https://www.googletagmanager.com/gtag/js?id='+siteConfig.ga4MeasurementId}></script><script is:inline define:vars={{ga4:siteConfig.ga4MeasurementId}}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',ga4);</script></>}
  </head>
  <body>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <script>import '../scripts/lead-form.js'; import '../scripts/ui.js';</script>
    <script is:inline defer src="https://api.airchatty.com/js/external-tracking.js" data-tracking-id={siteConfig.airchattyTrackingId}></script>
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
        if (!a) return;
        (typeof window.gtag === 'function' ? window.gtag : function () { (window.dataLayer = window.dataLayer || []).push(arguments); })('event', 'phone_call_tap', { page_path: location.pathname, link_url: a.getAttribute('href'), link_text: (a.textContent || '').trim().slice(0, 60) });
      }, true);
    </script>
  </body>
</html>
