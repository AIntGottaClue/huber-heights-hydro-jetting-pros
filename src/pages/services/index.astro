---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ContactSection from '../../components/ContactSection.astro';
import CardSection from '../../components/CardSection.astro';
import { services } from '../../data/pages';
import { u } from '../../lib/utils';
const title = 'Hydro Jetting Services in Huber Heights, OH';
const description = 'Hydro jetting for grease, roots, recurring clogs, mineral buildup and maintenance on drain and sewer lines in Huber Heights, Ohio.';
---
<Base title={title} description={description} path="/services/" crumbs={[{ name: 'Services', path: '/services/' }]}>
  <Hero headline="Hydro Jetting Services in Huber Heights, OH" intro="Each service page covers a different kind of blockage and when a closer look at the pipe matters." location="Services" crumbs={[{ href: '/services/', label: 'Services' }]} />
  <CardSection items={services.map((x) => ({ name: x.name, text: x.blurb, href: `/services/${x.slug}/` }))} cta="Learn about this service" />
  <ContactSection location="Services" />
</Base>
